# Rendered to ~/.config/chezmoi/chezmoi.toml by `chezmoi init`.
#
# Without this, a fresh init clones into ~/.local/share/chezmoi and every later
# `chezmoi` invocation looks in the wrong place. Pinning sourceDir here means
# the non-default ~/.dotfiles layout survives bringing up a new machine.
#
# chezmoi refuses to start if two config files exist in that directory
# ("multiple config files"), so an existing chezmoi.yaml there conflicts with
# this one.
sourceDir       = "{{ .chezmoi.homeDir }}/.dotfiles"
persistentState = "{{ .chezmoi.homeDir }}/.local/state/chezmoi/chezmoistate.boltdb"
