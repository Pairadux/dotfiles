#!/usr/bin/env zsh

######################################## EXPORT ENVIRONMENT VARIABLE ########################################

# Shells under Hyprland inherit ZDOTDIR, so zsh looks for $ZDOTDIR/.zshenv —
# a symlink back to this file. That makes it run in every shell, nested ones
# included, so everything below must be safe to re-run: dedup PATH up front.
typeset -U path

# XDG
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_BIN_HOME="$HOME/.local/bin"
export XDG_DOWNLOAD_DIR="$HOME/Downloads"
export XDG_DOCUMENTS_DIR="$HOME/Documents"
export XDG_PICTURES_DIR="$HOME/Cloud/Media/Pictures"
export XDG_VIDEOS_DIR="$HOME/Cloud/Media/Videos"
export XDG_MUSIC_DIR="$HOME/Cloud/Media/Music"
export XDG_PROJECTS_DIR="$HOME/Projects"

# SSH
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# DIRECTORIES
export DOTFILES="$HOME/.dotfiles"
export HYPRSHOT_DIR="$XDG_PICTURES_DIR/screenshots/hyprshot/"
export CLOUD="$HOME/Cloud"

# editor
export EDITOR="nvim"
export VISUAL="nvim"
export TERMINAL="ghostty"

# zsh
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export HISTFILE="$ZDOTDIR/.zhistory"
export HISTSIZE=10000
export SAVEHIST=10000

# go
export GOPATH=$HOME/.go
export GOBIN=$GOPATH/bin

# python
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv >/dev/null; then
    eval "$(pyenv init --path)"
fi

# antidote
export ANTIDOTE_HOME=~/.cache/antidote

# brew
export HOMEBREW_NO_ENV_HINTS=true

# fzf
export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
export FZF_DEFAULT_OPTS="\
    --highlight-line \
    --info=inline-right \
    --layout=reverse \
    --color=bg+:#283457 \
    --color=bg:#16161e \
    --color=border:#27a1b9 \
    --color=fg:#c0caf5 \
    --color=gutter:#16161e \
    --color=header:#ff9e64 \
    --color=hl+:#2ac3de \
    --color=hl:#2ac3de \
    --color=info:#545c7e \
    --color=marker:#ff007c \
    --color=pointer:#ff007c \
    --color=prompt:#2ac3de \
    --color=query:#c0caf5:regular \
    --color=scrollbar:#27a1b9 \
    --color=separator:#ff9e64 \
    --color=spinner:#ff007c \
"
export FZF_ALT_C_COMMAND="{ fd --type d --max-depth 4 \
    --exclude Library \
    --exclude Movies \
    --exclude Music \
    --exclude Pictures \
    --exclude Public \
    --exclude Archive \
    --exclude 'Projects/_*' \
    --exclude 'Creative Cloud Files' \
    --exclude google-cache-sdk; \
    fd --type d --max-depth 3 . .dotfiles .config 2>/dev/null; }"
export FZF_MARKS_FILE="$HOME/.local/share/.fzf-marks"

# from xdg-ninja
export GNUPGHOME="$XDG_DATA_HOME/gnupg"
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/nv"
export XAUTHORITY="$XDG_RUNTIME_DIR/Xauthority"
export WINEPREFIX="$XDG_DATA_HOME/wine"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc"
export NVM_DIR="$XDG_DATA_HOME/nvm"

# path
export PATH="$HOME/.bin:$HOME/.local/bin:$HOME/.cargo/bin:$GOBIN:$PATH"

# nvm: sourcing nvm.sh costs ~90ms, so put the default node on PATH directly
# and leave the nvm function to lazy-load in .zshrc. Aliases can chain
# (lts/* -> lts/jod -> v22.x); the walk is bounded so a cycle can't hang every
# shell. Stale nvm entries inherited from the login session are dropped.
() {
    local ver=default i
    for i in {1..5}; do
        [[ -f $NVM_DIR/alias/$ver ]] || break
        ver=$(<$NVM_DIR/alias/$ver)
    done
    local -a node=($NVM_DIR/versions/node/v${ver#v}(|.*)(N/nOn))
    (( $#node )) && path=($node[1]/bin ${path:#$NVM_DIR/*})
}

# pagers
if [[ $OSTYPE == darwin* ]]; then
    export LESSOPEN="| /opt/homebrew/bin/src-hilite-lesspipe.sh %s"
    export LESS='-R '
    export MANPAGER="less -R"
    export PAGER="less -R"

    export PATH="/Applications/MEGAcmd.app/Contents/MacOS:$PATH"
fi

# bob manages the neovim install where it's set up. Without it, warn only if no
# other nvim is on PATH (e.g. a distro package), since that's what leaves
# $EDITOR broken. Warn rather than abort: a fresh machine still needs a usable
# shell to fix itself with.
#
# The warning is gated on an interactive shell on purpose. .zshenv is sourced
# for every zsh invocation, and unsolicited stderr in a non-interactive one
# corrupts sftp/rsync-over-ssh sessions.
if [[ -r "$HOME/.local/share/bob/env/env.sh" ]]; then
    . "$HOME/.local/share/bob/env/env.sh"
elif [[ -o interactive ]] && ! command -v nvim >/dev/null; then
    print -u2 -P "%F{red}zshenv:%f nvim not found — install bob, then 'bob use stable'"
fi

# deadlock
export DL="$HOME/.local/share/Steam/steamapps/common/Deadlock"
export CSDK="$HOME/modding/deadlock/Reduced_CSDK_12"

#ssh
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
