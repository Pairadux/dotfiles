# chezmoi does not read .gitignore. Anything below is hidden from `git status`
# by ~/.config/git/ignore or dot_config/nvim/.gitignore, but without these rules
# chezmoi would still apply it to $HOME — an entire class of file that is
# invisible to review yet live in the config.
**/*.log
**/*.bak

# Generated by their own tools; the destination copy is the source of truth.
.config/nvim/doc/tags
.config/nvim/lazy-lock.json

# Machine-local personal dictionary, deliberately not synced between hosts.
.config/nvim/spell
.config/nvim/spell/**
