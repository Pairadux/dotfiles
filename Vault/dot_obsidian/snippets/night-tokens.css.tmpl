/*
  Design tokens for Obsidian's Minimal theme, generated by chezmoi from
  .chezmoidata/theme.toml and overwritten on every apply.
*/

.theme-dark.minimal-default-dark {
  --bg1: {{ .theme.surface.base }};
  --bg2: {{ .theme.surface.sunken }};
  --bg3: {{ .theme.surface.raised }};
  --ui1: {{ .theme.surface.hover }};
  --ui2: {{ .theme.role.border }};
  --ui3: {{ .theme.text.muted }};
  --tx1: {{ .theme.text.fg }};
  --tx2: {{ .theme.text.fg_dim }};
  --tx3: {{ .theme.text.muted }};
  --ax1: {{ .theme.role.focus }};
  --ax2: {{ .theme.role.focus }};
  --ax3: {{ .theme.role.focus }};
  --sp1: {{ .theme.role.on_accent }};
  --hl1: {{ .theme.surface.selection }};
  --hl2: {{ .theme.role.attention }}4d;

  --color-red: {{ .theme.role.error }};
  --color-orange: #ff9e64;
  --color-yellow: {{ .theme.role.attention }};
  --color-green: {{ .theme.role.success }};
  --color-cyan: #7dcfff;
  --color-blue: {{ .theme.role.info }};
  --color-purple: {{ .theme.role.focus }};
  --color-pink: #ff75a0;

  --font-interface-theme: "{{ .theme.font.sans }}";
  --font-text-theme: "{{ .theme.font.sans }}";
  --font-monospace-theme: "{{ .theme.font.mono }}";

  --radius-s: {{ .theme.shape.radius_control }}px;
  --radius-m: {{ .theme.shape.radius_nested }}px;
  --radius-l: {{ .theme.shape.radius_outer }}px;
}
