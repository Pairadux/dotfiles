{{- $m := includeTemplate "machine" . | fromJson -}}
-- This machine's facts, generated by chezmoi from .chezmoidata/machines.toml.
-- Do not edit: run `chezmoi apply` after changing that file instead.
--
-- Consumers derive behaviour from the capability flags (`multihead`, `laptop`,
-- `gametrak`), never from `hostname`, so a new machine is a data entry.
return {
    hostname  = {{ $m.hostname | quote }},
    arch      = {{ $m.arch | quote }},
    laptop    = {{ $m.laptop }},
{{ if $m.vaapi }}    vaapi     = {{ $m.vaapi | quote }},
{{ end }}    primary   = {{ $m.primary | quote }},
    secondary = {{ $m.secondary | quote }},
    multihead = {{ $m.multihead }},
    gametrak  = {{ $m.gametrak }},

    monitors = {
{{- range $m.monitors }}
        { output = {{ .output | quote }}, mode = {{ .mode | quote }}, position = {{ .position | quote }}, scale = {{ .scale }}{{ with dig "transform" 0 . }}, transform = {{ . }}{{ end }}{{ with dig "note" "" . }}, note = {{ . | quote }}{{ end }} },
{{- end }}
    },

    autostart = {
{{- range $m.autostart }}
        {{ . | quote }},
{{- end }}
    },

    commands = {
{{- range $k, $v := $m.commands }}
        [{{ $k | quote }}] = {{ $v | quote }},
{{- end }}
    },
}
