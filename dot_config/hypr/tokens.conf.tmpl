# Design tokens for hyprlock, generated by chezmoi from .chezmoidata/theme.toml and
# overwritten on every apply.
{{ range $k, $v := .theme.surface -}}
${{ $k }} = rgb({{ trimPrefix "#" $v }})
{{ end -}}
{{ range $k, $v := .theme.text -}}
${{ $k }} = rgb({{ trimPrefix "#" $v }})
{{ end -}}
{{ range $k, $v := .theme.role -}}
${{ $k }} = rgb({{ trimPrefix "#" $v }})
{{ end -}}
$glass = rgba({{ trimPrefix "#" .theme.surface.base }}{{ .theme.opacity.chrome_hex }})
$radius_outer = {{ .theme.shape.radius_outer }}
$border = {{ .theme.shape.border }}
$font_mono = {{ .theme.font.mono }}
$font_bar = {{ .theme.font.bar }}
$font_italic = {{ .theme.font.mono_italic }}
$font_sans = {{ .theme.font.sans }}
$font_cjk = {{ .theme.font.cjk_sans }}
