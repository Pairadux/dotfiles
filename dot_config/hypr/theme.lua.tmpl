{{- $m := includeTemplate "machine" . | fromJson -}}
{{- $fx := index .theme.effects $m.effects -}}
{{- $t := .theme -}}
-- Design tokens, generated by chezmoi from .chezmoidata/theme.toml and overwritten
-- on every apply. Colors are hex without the leading #.
return {
    color = {
{{- range $k, $v := $t.surface }}
        {{ $k }} = {{ trimPrefix "#" $v | quote }},
{{- end }}
{{- range $k, $v := $t.text }}
        {{ $k }} = {{ trimPrefix "#" $v | quote }},
{{- end }}
{{- range $k, $v := $t.role }}
        {{ $k }} = {{ trimPrefix "#" $v | quote }},
{{- end }}
    },

    gap_in  = {{ $t.shape.gap_in }},
    gap_out = {{ $t.shape.gap_out }},
    border  = {{ $t.shape.border }},
    radius  = {{ $t.shape.radius_outer }},

    shadow = {
        enabled = {{ $fx.shadow }},
        range   = {{ $fx.shadow_range }},
        power   = {{ $fx.shadow_power }},
        alpha   = {{ $fx.shadow_alpha | quote }},
    },

    blur = {
        size       = {{ $fx.blur_size }},
        passes     = {{ $fx.blur_passes }},
        brightness = {{ $fx.blur_brightness }},
    },

    motion = {
        t1        = {{ $t.motion.t1 }},
        t2        = {{ $t.motion.t2 }},
        t3        = {{ $t.motion.t3 }},
        t4        = {{ $t.motion.t4 }},
        t_fast_in = {{ $t.motion.t_fast_in }},
        spring_window    = { type = "spring", mass = {{ $t.motion.spring_window.mass }}, stiffness = {{ $t.motion.spring_window.stiffness }}, damping = {{ $t.motion.spring_window.damping }} },
        spring_workspace = { type = "spring", mass = {{ $t.motion.spring_workspace.mass }}, stiffness = {{ $t.motion.spring_workspace.stiffness }}, damping = {{ $t.motion.spring_workspace.damping }} },
        spring_layer     = { type = "spring", mass = {{ $t.motion.spring_layer.mass }}, stiffness = {{ $t.motion.spring_layer.stiffness }}, damping = {{ $t.motion.spring_layer.damping }} },
    },

    cursor = {
        name = {{ $t.cursor.name | quote }},
        size = {{ $t.cursor.size }},
    },
}
