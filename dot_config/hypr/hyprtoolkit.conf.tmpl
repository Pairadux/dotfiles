# Design tokens for hyprtoolkit, generated by chezmoi from .chezmoidata/theme.toml and
# overwritten on every apply.
background = rgb({{ trimPrefix "#" .theme.surface.base }})
base = rgb({{ trimPrefix "#" .theme.surface.sunken }})
alternate_base = rgb({{ trimPrefix "#" .theme.surface.raised }})
text = rgb({{ trimPrefix "#" .theme.text.fg }})
bright_text = rgb({{ trimPrefix "#" .theme.text.fg }})
accent = rgb({{ trimPrefix "#" .theme.role.focus }})
accent_secondary = rgb({{ trimPrefix "#" .theme.role.info }})
font_family = {{ .theme.font.sans }}
font_family_monospace = {{ .theme.font.mono }}
icon_theme = {{ .theme.icons.name }}
rounding_large = {{ .theme.shape.radius_outer }}
rounding_small = {{ .theme.shape.radius_control }}
