{{- $m := includeTemplate "machine" . | fromJson -}}
# This machine's facts, generated by chezmoi from .chezmoidata/machines.toml.
# Do not edit: run `chezmoi apply` after changing that file instead.
#
# Source this, don't run it. Branch on the capability flags, never on hostname.
# MACHINE_MULTIHEAD is the "has a real primary+secondary layout" capability;
# MACHINE_EXTERNAL is the first role-less display, empty when there is none.

MACHINE_HOSTNAME={{ $m.hostname | quote }}
MACHINE_LAPTOP={{ $m.laptop }}
MACHINE_MULTIHEAD={{ $m.multihead }}

MACHINE_PRIMARY={{ $m.primary | quote }}
MACHINE_SECONDARY={{ $m.secondary | quote }}
MACHINE_EXTERNAL={{ dig "output" "" $m.external | quote }}

# Wallpaper library, relative to $HOME (expanded when this file is sourced).
MACHINE_WALLPAPER_DIR="$HOME/{{ $m.wallpapers }}"
