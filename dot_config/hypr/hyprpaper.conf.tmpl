{{- $m := includeTemplate "machine" . | fromJson -}}
{{- /* A stacked primary+secondary pair is what the top/bottom wallpaper
       slices produced by ~/.bin/wallpaper-ctl assume. One display gets the
       unsliced source image instead. */ -}}
source = ~/.config/hypr/hyprpaper-wallpaper.conf

{{ if $m.multihead -}}
wallpaper {
    monitor = {{ $m.secondary }}
    path = $wallpaper_top
    fit_mode = stretch
}
wallpaper {
    monitor = {{ $m.primary }}
    path = $wallpaper_bottom
    fit_mode = stretch
}
{{ else -}}
wallpaper {
    monitor = {{ $m.primary }}
    path = $wallpaper_main
    fit_mode = cover
}
{{ end -}}
ipc = on
splash = false
