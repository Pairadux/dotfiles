/* Design tokens, generated by chezmoi from .chezmoidata/theme.toml and overwritten
   on every apply. The c- and t- prefixes keep these clear of rofi's own property
   names, since values set on * apply to every widget. */
* {
{{- range $k, $v := .theme.surface }}
    c-{{ $k }}: {{ $v }};
{{- end }}
{{- range $k, $v := .theme.text }}
    c-{{ replace "_" "-" $k }}: {{ $v }};
{{- end }}
{{- range $k, $v := .theme.role }}
    c-{{ replace "_" "-" $k }}: {{ $v }};
{{- end }}
    c-glass: {{ .theme.surface.base }}{{ .theme.opacity.chrome_hex }};
    c-focus-tint: {{ .theme.role.focus }}2e;
    t-radius-outer: {{ .theme.shape.radius_outer }}px;
    t-radius-control: {{ .theme.shape.radius_control }}px;
    t-border: {{ .theme.shape.border }}px;
    font: "{{ .theme.font.mono }}, {{ .theme.font.symbols }} 12";
}
