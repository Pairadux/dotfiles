/* Design tokens, generated by chezmoi from .chezmoidata/theme.toml and overwritten
   on every apply. */
* {
{{- range $k, $v := .theme.surface }}
    {{ $k }}: {{ $v }};
{{- end }}
{{- range $k, $v := .theme.text }}
    {{ replace "_" "-" $k }}: {{ $v }};
{{- end }}
{{- range $k, $v := .theme.role }}
    {{ replace "_" "-" $k }}: {{ $v }};
{{- end }}
    glass: {{ .theme.surface.base }}{{ .theme.opacity.chrome_hex }};
    radius-outer: {{ .theme.shape.radius_outer }}px;
    radius-control: {{ .theme.shape.radius_control }}px;
    border-width: {{ .theme.shape.border }}px;
    font: "{{ .theme.font.mono }} 12";
}
