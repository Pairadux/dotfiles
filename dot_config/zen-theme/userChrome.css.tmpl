/*
  Design tokens for Zen, generated by chezmoi from .chezmoidata/theme.toml and overwritten
  on every apply. Zen ignores Firefox-style themes, so these set its own variables.
*/

:root {
  color: {{ .theme.text.fg }} !important;
  --input-color: {{ .theme.text.fg }} !important;
  --zen-branding-dark: {{ .theme.surface.base }} !important;
  --toolbar-field-background-color: {{ .theme.surface.raised }} !important;
  --toolbar-field-focus-background-color: {{ .theme.surface.raised }} !important;
  --arrowpanel-background: {{ .theme.surface.raised }} !important;
  --zen-dialog-background: {{ .theme.surface.base }} !important;
}

/* Zen also sets these on each workspace. */
:root, zen-workspace {
  --zen-primary-color: {{ .theme.role.focus }} !important;
  --toolbox-textcolor: {{ .theme.text.fg }} !important;
}

/* Zen sets these on the background elements themselves. */
#zen-browser-background, #zen-toolbar-background {
  --zen-main-browser-background: {{ .theme.surface.sunken }} !important;
  --zen-main-browser-background-toolbar: {{ .theme.surface.sunken }} !important;
}

.tab-background {
  --tab-background-color-selected: {{ .theme.surface.raised }} !important;
}
