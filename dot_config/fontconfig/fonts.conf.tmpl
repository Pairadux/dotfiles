<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Generated by chezmoi from .chezmoidata/theme.toml. The Latin font comes first
     in each generic, so only glyphs it lacks reach the fallbacks. Noto CJK JP sits
     ahead of the other regions, which would otherwise win and draw Japanese text
     in Korean forms. -->
<fontconfig>
  <alias binding="same"><family>sans-serif</family>
    <prefer><family>{{ .theme.font.sans }}</family><family>{{ .theme.font.symbols }}</family><family>{{ .theme.font.cjk_sans }}</family></prefer></alias>
  <alias binding="same"><family>serif</family>
    <prefer><family>Noto Serif</family><family>{{ .theme.font.symbols }}</family><family>{{ .theme.font.cjk_serif }}</family></prefer></alias>
  <alias binding="same"><family>monospace</family>
    <prefer><family>{{ .theme.font.mono }}</family><family>{{ .theme.font.symbols }}</family><family>{{ .theme.font.cjk_mono }}</family></prefer></alias>
  <alias binding="same"><family>Noto Sans</family>
    <default><family>{{ .theme.font.cjk_sans }}</family></default></alias>
</fontconfig>
