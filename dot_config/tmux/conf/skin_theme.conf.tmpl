# Design tokens, generated by chezmoi from .chezmoidata/theme.toml and overwritten
# on every apply. Hidden, so they stay out of the environment of programs in panes.
{{ range $k, $v := .theme.surface -}}
%hidden color_{{ $k }}="{{ $v }}"
{{ end -}}
{{ range $k, $v := .theme.text -}}
%hidden color_{{ $k }}="{{ $v }}"
{{ end -}}
{{ range $k, $v := .theme.role -}}
%hidden color_{{ $k }}="{{ $v }}"
{{ end -}}
