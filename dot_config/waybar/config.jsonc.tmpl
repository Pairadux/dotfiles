{{- $m := includeTemplate "machine" . | fromJson -}}
// waybar — the bar for machines that cannot run hyprpanel (Arch Linux ARM has
// no hyprpanel package). Layout follows the hyprpanel bar so the two machines
// feel alike: power + workspaces on the left, status cluster on the right. With
// no media module, the focused app takes the middle instead.
//
// Battery and backlight are emitted only on laptops; workspace pinning only on
// a machine that actually has two displays. Both come from machines.toml.
{
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "margin-left": 10,
    "margin-right": 10,
    "margin-top": 7,
    "margin-bottom": 0,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/power",
        "hyprland/workspaces",
    ],
    "modules-center": [
        "hyprland/window"
    ],
    // No tray: its only item is nm-applet, which duplicates the network
    // module, and waybar cannot hide a single item (hyprpanel ignores it).
    "modules-right": [
        "group/volume",
{{ if $m.laptop }}        "group/brightness",
{{ end }}        "network",
        "bluetooth",
{{ if $m.laptop }}        "battery",
{{ end }}        "clock"
    ],

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "left-click: shutdown\nmiddle-click: suspend\nright-click: reboot",
        "on-click": "shutdown now",
        "on-click-right": "reboot",
        "on-click-middle": "systemctl suspend"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        // 1-10 keep the kanji numerals; the named workspaces reuse the same
        // glyphs as hyprpanel's workspaceIconMap so muscle memory carries over.
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "20": "󰊠",
            "30": "",
            "40": "",
            "50": "",
            "60": "󰇮",
            "70": "",
            "100": "",
            "special": ""
        },
{{ if $m.multihead }}        "persistent-workspaces": {
            "{{ $m.primary }}": [
                1
            ],
            "{{ $m.secondary }}": [
                2
            ]
        },
{{ else }}        // Single display: no workspace is pinned to an output, so keep 1 and 2
        // present on the only bar there is.
        "persistent-workspaces": {
            "*": [
                1
            ]
        },
{{ end }}        "show-special": true,
        "special-visible-only": true
    },

    "hyprland/window": {
        "format": "⊣ {class} ⊢",
        "max-length": 120,
        "icon": false,
        // A class is the app ID, often reverse-DNS; show the app's name instead.
        // Each rule has to match the whole formatted label, ignoring case.
        "rewrite": {
            "⊣ com\\.mitchellh\\.ghostty ⊢": "⊣ Ghostty ⊢",
            "⊣ zen(-alpha|-beta|-browser)? ⊢": "⊣ Zen Browser ⊢",
            "⊣ org\\.pulseaudio\\.pavucontrol ⊢": "⊣ Volume Control ⊢",
            "⊣ blueman-manager ⊢": "⊣ Bluetooth Manager ⊢",
            "⊣ nm-connection-editor ⊢": "⊣ Network Connections ⊢",
            "⊣ com\\.moonlight_stream\\.moonlight ⊢": "⊣ Moonlight ⊢",
            "⊣ keymapp ⊢": "⊣ Keymapp ⊢",
            "⊣ steam ⊢": "⊣ Steam ⊢"
        }
    },

    // Hovering a level icon slides its percentage out beside it, so the number
    // is visible while scrolling. The drawer opens leftward so the icon stays
    // put under the cursor on this right-aligned cluster.
    "group/volume": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": [
            "pulseaudio",
            "pulseaudio#level"
        ]
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "tooltip-format": "{icon}  {desc} // {volume}%",
        // The default threshold of 0 fires a full step on every tiny trackpad
        // delta, so one swipe floods dozens of steps that keep landing after
        // the fingers stop. Make the travel accumulate before each step.
        "smooth-scrolling-threshold": 5,
        // snap-step keeps the level on multiples of 5, which the built-in
        // scroll-step cannot.
        "on-scroll-up": "~/.config/waybar/scripts/snap-step.sh volume 5",
        "on-scroll-down": "~/.config/waybar/scripts/snap-step.sh volume -5",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󱡏",
            "headset": "󰋎",
            "phone": "",
            "portable": "󱡏",
            "car": "",
            "default": [
                "",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol"
    },

    // The number the volume drawer slides out. It scrolls like the icon, since
    // the cursor often ends up on it once it is revealed.
    "pulseaudio#level": {
        "format": "{volume}%",
        "format-muted": "{volume}%",
        "tooltip": false,
        "smooth-scrolling-threshold": 5,
        "on-scroll-up": "~/.config/waybar/scripts/snap-step.sh volume 5",
        "on-scroll-down": "~/.config/waybar/scripts/snap-step.sh volume -5"
    },
{{ if $m.laptop }}
    "group/brightness": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": [
            "backlight",
            "backlight#level"
        ]
    },

    "backlight": {
        "format": "{icon}",
        "tooltip-format": "Backlight: {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        // Same trackpad flood and grid snapping as pulseaudio above.
        "smooth-scrolling-threshold": 5,
        "on-scroll-up": "~/.config/waybar/scripts/snap-step.sh brightness 5",
        "on-scroll-down": "~/.config/waybar/scripts/snap-step.sh brightness -5"
    },

    "backlight#level": {
        "format": "{percent}%",
        "tooltip": false,
        "smooth-scrolling-threshold": 5,
        "on-scroll-up": "~/.config/waybar/scripts/snap-step.sh brightness 5",
        "on-scroll-down": "~/.config/waybar/scripts/snap-step.sh brightness -5"
    },
{{ end }}
    "network": {
        "format": "󰈀",
        "format-wifi": "{icon}",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥"
        ],
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰤭",
        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>",
        "tooltip-format-ethernet": "Ethernet\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor",
        "interval": 5
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "",
        "format-connected": "󰂱",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "on-click": "blueman-manager"
    },
{{ if $m.laptop }}
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁽",
            "󰁿",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{capacity}% — {timeTo}\nPower draw: {power}W",
        "interval": 30
    },
{{ end }}
    "clock": {
        "format": "{:%a %b %d  %I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#7aa2f7'><b>{}</b></span>",
                "weekdays": "<span color='#e0af68'><b>{}</b></span>",
                "today": "<span color='#f7768e'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode"
        }
    }
}
