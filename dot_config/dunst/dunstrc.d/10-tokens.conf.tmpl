# Design tokens for dunst, generated by chezmoi from .chezmoidata/theme.toml and
# overwritten on every apply. Drop-ins override the base dunstrc.
[global]
    font = "{{ .theme.font.sans }} 15px"
    frame_width = {{ .theme.shape.border }}
    corner_radius = {{ .theme.shape.radius_outer }}
    # gap_out plus the window border, which puts the frame just inside a window's border.
    offset = ({{ add .theme.shape.gap_out .theme.shape.border }}, {{ add .theme.shape.gap_out .theme.shape.border }})
    icon_theme = {{ .theme.icons.name }}

[urgency_low]
    background = "{{ .theme.surface.base }}{{ .theme.opacity.chrome_hex }}"
    foreground = "{{ .theme.text.fg_dim }}"
    frame_color = "{{ .theme.role.border }}"
    highlight = "{{ .theme.role.info }}"

[urgency_normal]
    background = "{{ .theme.surface.base }}{{ .theme.opacity.chrome_hex }}"
    foreground = "{{ .theme.text.fg }}"
    frame_color = "{{ .theme.role.border }}"
    highlight = "{{ .theme.role.focus }}"

[urgency_critical]
    background = "{{ .theme.surface.base }}{{ .theme.opacity.chrome_hex }}"
    foreground = "{{ .theme.role.error }}"
    frame_color = "{{ .theme.role.error }}"
    highlight = "{{ .theme.role.error }}"
